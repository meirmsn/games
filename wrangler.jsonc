// Cloudflare deploy config: the site is static files served straight from the repo root.
// Workers Builds runs `npx wrangler deploy` on main and uploads a preview version for other branches.
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "games",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./"
  },
  // The site lives only on the custom domain games.meirmsn.dev (set in the dashboard for
  // production and previews), so both workers.dev addresses stay off. Each PR's preview is at
  // <branch>.games.meirmsn.dev.
  "workers_dev": false,
  "preview_urls": false,
  // Needed by `wrangler preview`, which builds the per-PR preview links; empty is enough.
  "previews": {}
}
